rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 🛡️ Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // Máximo 10MB
    }

    // 📷 Fotos de personas desaparecidas
    match /desaparecidos/{allPaths=**} {
      // Lectura pública para difusión comunitaria y afiches
      allow read: if true;
      // Escritura y reemplazo reservado a personal autenticado con validación de imagen
      allow write: if isAuthenticated() && isValidImage();
    }

    // 👤 Fotos de perfil de ciudadanos
    match /ciudadanos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // 💬 Fotos adjuntas en comentarios/pistas de avistamiento
    match /pistas/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImage();
    }

    // 📄 Documentos oficiales y actas policiales (PDF)
    match /actas/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                   request.resource.contentType == 'application/pdf' &&
                   request.resource.size < 15 * 1024 * 1024;
    }

    // 🎥 Recursos y videos educativos públicos
    match /recursos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
