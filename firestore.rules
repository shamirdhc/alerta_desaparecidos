rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ FUNCIONES AUXILIARES DE AUTORIZACIÓN
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPolice() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/policias/$(request.auth.uid));
    }

    function isPoliceAdmin() {
      return isPolice() && 
        get(/databases/$(database)/documents/policias/$(request.auth.uid)).data.admin == true;
    }

    // 🚨 COLECCIÓN DE PERSONAS DESAPARECIDAS
    match /desaparecidos/{desaparecidoId} {
      // Cualquier persona puede consultar casos para apoyar en la búsqueda pública
      allow read: if true;
      
      // Solo agentes policiales autenticados pueden registrar, modificar o cambiar estado
      allow create, update, delete: if isPolice();

      // 💬 SUBCOLECCIÓN DE PISTAS Y COMENTARIOS COMUNITARIOS
      match /comments/{commentId} {
        // Lectura pública para que toda la ciudadanía y la policía puedan colaborar
        allow read: if true;

        // Creación: Cualquier usuario registrado/autenticado puede aportar pistas y comentarios
        allow create: if isAuthenticated() && 
                         request.resource.data.userId == request.auth.uid;

        // Modificación de estado (Aprobar, Reservar, Rechazar): Exclusivo de la PNP
        allow update, delete: if isPolice();
      }
    }

    // 👤 COLECCIÓN DE CIUDADANOS (PROTECCIÓN ESTRICTA DE PII / PRIVACIDAD)
    match /ciudadanos/{userId} {
      // El ciudadano solo puede leer y editar su propio perfil (teléfono, DNI, datos personales)
      // La policía puede leer perfiles de informantes para verificación y contacto en investigaciones
      allow read: if isOwner(userId) || isPolice();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isPolice();
    }

    // 👮 COLECCIÓN DE POLICÍAS Y UNIDADES DEPITPTIM
    match /policias/{policeId} {
      // Lectura para verificar estado operativo de cuentas policiales
      allow read: if isAuthenticated();
      // Creación, edición y borrado restringido a administradores (o auto-sincronización de perfil propio)
      allow create: if isPoliceAdmin() || isOwner(policeId);
      allow update: if isPoliceAdmin() || isOwner(policeId);
      allow delete: if isPoliceAdmin();
    }

    // 🏛️ HISTORIAL DE PERSONAS ENCONTRADAS (CASOS RESUELTOS)
    match /historial_encontrados/{id} {
      allow read: if true;
      allow write: if isPolice();
    }

    // 🔔 NOTIFICACIONES Y ALERTAS
    match /notificaciones/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isPolice();
    }

    // 💡 RECOMENDACIONES Y SUGERENCIAS CIUDADANAS
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isPolice();
    }

    // 🏢 DIRECTORIO NACIONAL DE COMISARÍAS PNP
    match /comisarias/{comisariaId} {
      // Acceso público para que cualquier ciudadano pueda ver los números de contacto en tiempo real
      allow read: if true;
      // Actualización de números telefónicos o sedes por parte de oficiales PNP autenticados
      allow create, update: if isPolice();
      allow delete: if isPolice();
    }

    // ⚙️ ESTADO DEL SISTEMA Y SINCRONIZACIÓN PNP
    match /system_status/{docId} {
      allow read: if isAuthenticated();
      allow write: if isPoliceAdmin();
    }

    // 🔄 CONFIGURACIÓN Y MANIFIESTO DE SINCRONIZACIÓN PNP (PLAN FREE)
    match /config/{docId} {
      allow read: if true;
      allow write: if isPoliceAdmin();
    }
  }
}
