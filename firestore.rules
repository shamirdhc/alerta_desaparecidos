rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ FUNCIONES AUXILIARES DE AUTORIZACIÓN Y DEVSECOPS
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPolice() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/policias/$(request.auth.uid));
    }

    function isPoliceAdmin() {
      return isPolice() && 
        get(/databases/$(database)/documents/policias/$(request.auth.uid)).data.admin == true;
    }

    // Validación de cadena segura (longitud y prevención de Stored XSS)
    function isSafeString(val, minLen, maxLen) {
      return val is string &&
             val.size() >= minLen &&
             val.size() <= maxLen &&
             !val.matches('.*(<script|javascript:|onerror=|onload=|<iframe).*');
    }

    // 🚨 1. COLECCIÓN DE PERSONAS DESAPARECIDAS
    match /desaparecidos/{desaparecidoId} {
      // Cualquier persona puede consultar casos para apoyar en la búsqueda pública
      allow read: if true;
      
      // Creación y actualización reservada a agentes policiales autorizados
      allow create, update: if isPolice();

      // Prohibido borrar registros históricos salvo SuperAdmin policial con registro
      allow delete: if isPoliceAdmin();

      // 💬 SUBCOLECCIÓN DE PISTAS Y COMENTARIOS COMUNITARIOS
      match /comments/{commentId} {
        // Lectura pública para colaboración ciudadana
        allow read: if true;

        // Creación: Cualquier usuario registrado/autenticado puede aportar pistas
        allow create: if isAuthenticated() && 
                         request.resource.data.userId == request.auth.uid;

        // Modificación de estado (Aprobar, Reservar, Rechazar) y borrado exclusivo PNP
        allow update, delete: if isPolice();
      }
    }

    // 👤 2. COLECCIÓN DE CIUDADANOS (PROTECCIÓN ESTRICTA DE PII Y PRIVILEGIOS)
    match /ciudadanos/{userId} {
      allow read: if isOwner(userId) || isPolice();
      // Impedir que un ciudadano auto-asigne roles privilegiados en su propio documento
      allow create, update: if isOwner(userId) &&
        (!('rol' in request.resource.data) || request.resource.data.rol == 'ciudadano');
      allow delete: if isOwner(userId) || isPoliceAdmin();
    }

    // 👮 3. COLECCIÓN DE POLICÍAS Y UNIDADES DEPITPTIM
    match /policias/{policeId} {
      allow read: if isAuthenticated();
      // Creación restringida a Administrador PNP o registro inicial
      allow create: if isPoliceAdmin() || isOwner(policeId);
      // Un efectivo policial NO puede auto-otorgarse permisos de administrador (admin: true)
      allow update: if isPoliceAdmin() || 
        (isOwner(policeId) && 
         (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin));
      allow delete: if isPoliceAdmin();
    }

    // 🏛️ 4. HISTORIAL DE PERSONAS ENCONTRADAS (CASOS RESUELTOS)
    match /historial_encontrados/{id} {
      allow read: if true;
      allow write: if isPolice();
    }

    // 🔔 5. NOTIFICACIONES Y ALERTAS
    match /notificaciones/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isPolice();
    }

    // 💡 6. RECOMENDACIONES Y SUGERENCIAS CIUDADANAS
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isPolice();
    }

    // 🏢 7. DIRECTORIO NACIONAL DE COMISARÍAS PNP
    match /comisarias/{comisariaId} {
      allow read: if true;
      allow create, update, delete: if isPolice();
    }

    // ⚙️ 8. ESTADO DEL SISTEMA Y SINCRONIZACIÓN PNP
    match /system_status/{docId} {
      allow read: if isAuthenticated();
      allow write: if isPoliceAdmin();
    }

    // 🔄 9. CONFIGURACIÓN Y MANIFIESTO DE SINCRONIZACIÓN PNP
    match /config/{docId} {
      allow read: if true;
      allow write: if isPolice();
    }

    // Bloqueo por defecto para cualquier otra ruta no declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
