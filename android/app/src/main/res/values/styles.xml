<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado mientras la aplicación está iniciando -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema principal de la aplicación -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Agregar esta línea -->
        <item name="buttonBarButtonStyle">@style/Widget.AppCompat.Button.Borderless</item>
    </style>

    <!-- Tema aplicado cuando el proceso ha iniciado -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Tema específico para la actividad UCrop -->
    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Fondo de la actividad -->
        <item name="android:windowBackground">@android:color/white</item>

        <!-- Colores primarios -->
        <item name="android:colorPrimary">#1E88E5</item>
        <item name="android:colorPrimaryDark">#1565C0</item>
        <item name="android:colorAccent">#43A047</item>

        <!-- Estilo de los botones -->
        <item name="android:buttonStyle">@style/Widget.AppCompat.Button.Colored</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.AppCompat.Button</item> <!-- Ajustado para evitar errores -->

        <!-- Estilo de los textos -->
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/darker_gray</item>

        <!-- Icono de la actividad -->
        <item name="android:icon">@mipmap/launcher_icon</item> <!-- Cambio aquí -->

        <!-- Margen de las vistas -->
        <item name="android:contentInsetLeft">0dp</item>
        <item name="android:contentInsetRight">0dp</item>
    </style>
</resources>