<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Muestra la pantalla de inicio mientras la aplicación se carga -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema principal para la aplicación -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Configuraciones personalizadas -->
    </style>

    <!-- Tema para cuando el proceso ya ha iniciado -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar"> <!-- Ajusté el tema base -->
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>