{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "alerta-desaparecidos-pnp",
          "appId": "1:75698715605:android:0457d3e14a710c5c151b5c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "alerta-desaparecidos-pnp",
          "configurations": {
            "android": "1:75698715605:android:0457d3e14a710c5c151b5c",
            "ios": "1:75698715605:ios:99a336d9f0e533db151b5c",
            "web": "1:75698715605:web:a77a01a49471b69d151b5c",
            "windows": "1:75698715605:web:25fe2de4fc75b680151b5c"
          }
        }
      }
    }
  },
  "hosting": [
    {
      "site": "pnpalerta",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|wasm|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/flutter_bootstrap.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate, max-age=0"
            }
          ]
        }
      ]
    },
